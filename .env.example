# =======================================================
# FLOODSCAPE AI — ENVIRONMENT CONFIGURATION TEMPLATE
# =======================================================

# Backend Database Connection
# SQLite (default for instant local run):
DATABASE_URL=sqlite:///./floodscape.db

# Supabase / Hosted PostgreSQL + PostGIS (for production):
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Server Settings
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*

# Frontend Environment Variables (in frontend/.env)
# VITE_API_URL=http://127.0.0.1:8000/api
# In production on Vercel:
# VITE_API_URL=https://[YOUR-RENDER-BACKEND-URL]/api
